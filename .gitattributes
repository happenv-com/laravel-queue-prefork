# Path-based git attributes
# https://git-scm.com/docs/gitattributes

* text=auto eol=lf

*.blade.php diff=html
*.css       diff=css
*.html      diff=html
*.md        diff=markdown
*.php       diff=php
*.png       binary
*.jpg       binary
*.gif       binary

# Everything below stays out of the archive Composer installs.

# Repository metadata
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github                export-ignore
/.editorconfig          export-ignore
/.idea                  export-ignore
/.vscode                export-ignore
/moat.toml              export-ignore
.DS_Store               export-ignore

# Agent / assistant files
/.claude                export-ignore
/.serena                export-ignore
/AGENTS.md              export-ignore
/CLAUDE.md              export-ignore

# Docs & media not needed at runtime
/art                    export-ignore
/docs                   export-ignore
/images                 export-ignore
/screenshots            export-ignore
/CHANGELOG.md           export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/UPGRADING.md           export-ignore
/TODO.md                export-ignore

# Tests & QA tooling
/tests                  export-ignore
/workbench              export-ignore
/build                  export-ignore
/testbench.yaml         export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/phpstan-baseline.neon  export-ignore
/pint.json              export-ignore
/rector.php             export-ignore
/composer.lock          export-ignore
# @npm-start

# Front-end toolchain
/node_modules           export-ignore
/.npmrc                 export-ignore
/.nvmrc                 export-ignore
/package-lock.json      export-ignore
/package.json           export-ignore
# @npm-end
# @assets-start

# Asset sources: the service provider registers the build output in
# resources/dist. Drop these two lines if consumers import the sources.
/.prettierignore        export-ignore
/.prettierrc            export-ignore
/bin                    export-ignore
/resources/css          export-ignore
/resources/js           export-ignore
# @assets-end
